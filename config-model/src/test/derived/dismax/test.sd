schema dismax {

    document dismax {
        field title type string {
            indexing: index
        }
        field brand type string {
            indexing: index
        }
        field description type string {
            indexing: index
        }
    }

    rank-profile default {
        rank-properties {
            dismax.tie: 0.2
            dismax.boost.title: 10000
            dismax.boost.brand: 10000
            dismax.boost.description: 1000
        }
        function inline text_score() {
            expression: dismax * 10.0 / 18000.0
        }
        first-phase {
            expression: text_score
        }
        match-features {
            dismax
        }
    }

}
